# CGI有効化
Options +ExecCGI
AddHandler cgi-script .cgi

# セキュリティヘッダー
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "DENY"
Header set X-XSS-Protection "1; mode=block"

# API リクエスト処理
RewriteEngine On
RewriteBase /japan-etf-analyzer/

# AuthorizationヘッダーをCGI環境変数に渡す（API key認証用）
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# sitemap.xmlをバックエンドAPIで動的生成
RewriteRule ^sitemap\.xml$ api/index.cgi/v1/sitemap.xml [L]

# APIリクエストをindex.cgiにルーティング（index.cgi自体は除外）
RewriteCond %{REQUEST_URI} !index\.cgi
RewriteRule ^api/(.*)$ api/index.cgi/$1 [L,QSA]

# ノートページ プリレンダーHTML配信（OGP対応）
RewriteRule ^notes/([^/.]+)$ notes/$1.html [L]

# SPAルーティング（フロントエンド）
# 既存ファイル・ディレクトリは直接配信
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# APIリクエストは除外
RewriteCond %{REQUEST_URI} !^/japan-etf-analyzer/api/
# index.htmlにフォールバック
RewriteRule . index.html [L]

# エラーページ
ErrorDocument 404 /japan-etf-analyzer/index.html
ErrorDocument 500 /japan-etf-analyzer/error.html
