# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Database
DATABASE_URL=sqlite:///data/etf.db

# Application Paths (for Sakura rental server)
APP_BASE_DIR=/home/your-account/www/japan-etf-analyzer
APP_DATA_DIR=/home/your-account/www/japan-etf-analyzer/data

# External API
USE_MOCK_DATA=false
CACHE_TTL=300

# X (Twitter) API - for /x-publish skill
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret

# Notes Management API
# 注: demo書込系API（POST /api/v1/demo/trades, /api/v1/demo/cash-flows）も
# 同じapi_key_requiredデコレータ経由でこのキーを要求する（execute_demo_trades.py cron専用）
NOTES_API_KEY=
PRODUCTION_API_URL=https://kima3.net/japan-etf-analyzer/api/v1/notes/sync

# CORS許可オリジン（カンマ区切りで複数可）。未設定時の既定は開発用 http://localhost:3902
# 本番例: CORS_ORIGINS=https://kima3.net
# CORS_ORIGINS=https://kima3.net

# Cron Batch Profile (dev|prod). Default: dev
# 開発環境ではdevのまま（advisor 4本+theme_etfs+watcher を含む全ジョブを実行）。
# 本番デプロイ時は prod に設定し、開発専用ジョブを除外する。
# CRON_BATCH_PROFILE=dev

# Daily Advisor (毎日のタスク通知システム)
ADVISOR_USER_ID=test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_SENDER=your-gmail-address@gmail.com
NOTIFY_TO_EMAIL=your-recipient@example.com
ADVISOR_REPORTS_DIR=reports/test/daily-tasks
STRATEGY_FILE=docs/12_personal_strategy.md

# デモユーザー向けポートフォリオ変更通知メール（execute_demo_trades.py / cron Step 7）
# 宛先は NOTIFY_TO_EMAIL を流用。詳細は docs/06b_メール通知仕様.md 参照。
DEMO_PORTFOLIO_REPORT_ENABLED=0       # 1=有効、0=無効（既定）
DEMO_PORTFOLIO_REPORT_TRIGGER=on_trade  # on_trade（取引動いた日のみ） / always（dry-runも） / never

# ETF Rating メール送信（/etf-rating スキル → etf_rating_send_mail.py）
# 1=実送信、未設定または 0=強制 dry-run（本文プレビューのみ・送信なし）
# 宛先は NOTIFY_TO_EMAIL を流用。
ETF_RATING_MAIL_ENABLED=0

# バッチ最終失敗アラート（batch_monitor.py）
# リトライ上限(3回)到達で完全失敗が確定したバッチを1回だけメール通知する。
# 宛先は NOTIFY_TO_EMAIL を流用。1=有効、未設定または 0=無効（既定）。
BATCH_ALERT_ENABLED=0
