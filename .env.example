# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Database
DATABASE_URL=sqlite:///data/etf.db

# Application Paths (for Sakura rental server)
APP_BASE_DIR=/home/your-account/www/japan-etf-analyzer
APP_DATA_DIR=/home/your-account/www/japan-etf-analyzer/data

# External API
USE_MOCK_DATA=false
CACHE_TTL=300

# X (Twitter) API - for /x-publish skill
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret

# CORS (if needed)
# CORS_ORIGINS=https://your-domain.com
