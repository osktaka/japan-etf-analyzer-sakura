# ETF Analyzer Scheduled Tasks
# Timezone: Asia/Tokyo (set in Dockerfile.scheduler)

# 毎日朝6時: ETFマスタ更新(JPXからスクレイピング→DB同期)→評価スコア更新
0 6 * * * cd /app && /usr/local/bin/python3 scripts/fetch_etf_list.py >> /var/log/cron.log 2>&1 && /usr/local/bin/python3 scripts/sync_etf_master.py >> /var/log/cron.log 2>&1 && /usr/local/bin/python3 scripts/update_scores.py >> /var/log/cron.log 2>&1

# 平日16時: 株価データ更新(東証閉場後、スマートモード)→評価スコア更新
0 16 * * 1-5 cd /app && /usr/local/bin/python3 scripts/update_etf_data.py --smart >> /var/log/cron.log 2>&1 && /usr/local/bin/python3 scripts/update_scores.py >> /var/log/cron.log 2>&1

# 毎週日曜朝5時: ログローテーション
0 5 * * 0 cd /app && /usr/local/bin/python3 scripts/rotate_logs.py >> /app/logs/rotate.log 2>&1

# 空行が必要(cronの仕様)
