{% from '_macros.j2' import bucket_label, rule_kind_label, action_label %}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>リバランス通知 {{ today.strftime('%Y-%m-%d') }}</title>
</head>
<body style="margin:0;padding:0;background:#fff;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',sans-serif;font-size:16px;line-height:1.6;color:#222;">
<div style="max-width:600px;margin:0 auto;padding:16px;">

<h1 style="font-size:20px;margin:0 0 16px;">リバランス通知 {{ today.strftime('%Y-%m-%d') }}</h1>

{% if rebalance_plan.is_rebalance_day %}
<div style="background:#fff8e1;border-left:4px solid #c79100;border-radius:4px;padding:16px;margin:16px 0;">
{% else %}
<div style="background:#f7f9fc;border-left:4px solid #2c5aa0;border-radius:4px;padding:16px;margin:16px 0;">
{% endif %}
  <p style="margin:0 0 8px;font-weight:bold;font-size:18px;">{{ urgency_tag }} — 次回まで{{ rebalance_plan.days_to_next_rebalance }}日（{{ rebalance_plan.next_rebalance_date.strftime('%Y-%m-%d') }}）</p>
  <p style="margin:0;">{{ summary | e | replace('\n\n', '<br><br>') | replace('\n', '<br>') | safe }}</p>
</div>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">現状サマリ</h2>
<dl style="margin:0;">
  <dt style="font-weight:bold;margin-top:8px;">総資産</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(rebalance_plan.total_asset) }}円</dd>
{% if rebalance_plan.daily_pnl_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">当日損益</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(rebalance_plan.daily_pnl_pct) }}%</dd>
{% endif %}
  <dt style="font-weight:bold;margin-top:8px;">現金残</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(rebalance_plan.current_cash) }}円（目標 {{ "{:,.0f}".format(rebalance_plan.target_cash) }}円、乖離 {{ "%+.2f"|format(rebalance_plan.cash_deviation_pp) }}pp）</dd>
  <dt style="font-weight:bold;margin-top:8px;">個別逸脱</dt>
  <dd style="margin:0 0 4px 0;">
    {% if rebalance_plan.critical_count > 0 %}<span style="display:inline-block;background:#fdecec;color:#c0392b;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">CRITICAL {{ rebalance_plan.critical_count }}件</span>{% endif %}
    {% if rebalance_plan.warn_count > 0 %}<span style="display:inline-block;background:#fff8e1;color:#c79100;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">WARN {{ rebalance_plan.warn_count }}件</span>{% endif %}
    {% if rebalance_plan.critical_count == 0 and rebalance_plan.warn_count == 0 %}<span style="color:#888;">なし</span>{% endif %}
  </dd>
</dl>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">保有・配分</h2>
<ul style="margin:0;padding-left:20px;">
{% for s in rebalance_plan.holdings_snapshots %}
<li style="margin-bottom:10px;">
  {% if s.classification == 'CRITICAL' %}<span style="display:inline-block;background:#fdecec;color:#c0392b;padding:2px 6px;border-radius:3px;font-size:11px;margin-right:6px;">CRITICAL</span>
  {% elif s.classification == 'WARN' %}<span style="display:inline-block;background:#fff8e1;color:#c79100;padding:2px 6px;border-radius:3px;font-size:11px;margin-right:6px;">WARN</span>
  {% endif %}
  <strong>{{ s.etf_code }} {{ s.name }}</strong>{% if not s.is_adopted %} <span style="color:#c0392b;font-size:12px;">(採用外)</span>{% endif %}<br>
  <span style="color:#555;font-size:14px;">
    {{ "{:,.0f}".format(s.quantity) }}株 / {{ "{:,.0f}".format(s.current_value) }}円
    {% if s.quantity == 0 or s.pnl_pct is none %}/ 損益 —{% else %}/ 損益 {{ "%+.2f"|format(s.pnl_pct) }}%{% endif %}<br>
    実績 {{ "%.2f"|format(s.actual_pct) }}% → 目標 {{ "%.2f"|format(s.target_pct) }}% （乖離 {{ "%+.2f"|format(s.drift_pp) }}pp）
  </span>
</li>
{% endfor %}
<li style="margin-bottom:10px;">
  <strong>現金</strong><br>
  <span style="color:#555;font-size:14px;">
    {{ "{:,.0f}".format(rebalance_plan.current_cash) }}円<br>
    実績 {{ "%.2f"|format(rebalance_plan.current_cash / rebalance_plan.total_asset * 100.0 if rebalance_plan.total_asset > 0 else 0) }}% → 目標 10.00% （乖離 {{ "%+.2f"|format(rebalance_plan.cash_deviation_pp) }}pp）
  </span>
</li>
</ul>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">アクション提案</h2>
{% if rebalance_plan.is_rebalance_day %}
<p style="margin:8px 0;font-weight:bold;color:#c79100;">本日は四半期末リバランス基準日です。</p>

{% if rebalance_plan.sell_actions %}
<h3 style="font-size:16px;margin:16px 0 8px;">売却</h3>
<ul style="margin:0;padding-left:20px;">
{% for a in rebalance_plan.sell_actions %}
<li style="margin-bottom:8px;"><strong>{{ a.etf_code }}</strong> {{ a.quantity }}株（約{{ "{:,.0f}".format(a.amount) }}円） — {{ a.reason }}</li>
{% endfor %}
</ul>
{% endif %}

{% if rebalance_plan.buy_actions %}
<h3 style="font-size:16px;margin:16px 0 8px;">買付</h3>
<ul style="margin:0;padding-left:20px;">
{% for a in rebalance_plan.buy_actions %}
<li style="margin-bottom:8px;"><strong>{{ a.etf_code }}</strong> {{ a.quantity }}株（約{{ "{:,.0f}".format(a.amount) }}円） — {{ a.reason }}</li>
{% endfor %}
</ul>
{% endif %}

{% if not rebalance_plan.sell_actions and not rebalance_plan.buy_actions %}
<p style="margin:8px 0;">売買アクションなし（floor単元未満で全て繰越）。</p>
{% endif %}
{% else %}
<p style="margin:8px 0;">本日は監視のみ。次回リバランス（{{ rebalance_plan.next_rebalance_date.strftime('%Y-%m-%d') }}）まで{{ rebalance_plan.days_to_next_rebalance }}日です。</p>
{% if rebalance_plan.critical_count > 0 or rebalance_plan.warn_count > 0 %}
<p style="margin:8px 0;color:#666;font-size:14px;">逸脱状況の参考: CRITICAL {{ rebalance_plan.critical_count }}件 / WARN {{ rebalance_plan.warn_count }}件。次回基準日に推奨アクションを執行予定。</p>
{% else %}
<p style="margin:8px 0;color:#888;font-size:14px;">逸脱なし。通常運用継続。</p>
{% endif %}
{% endif %}

<hr style="border:none;border-top:1px solid #ddd;margin:24px 0 12px;">
<p style="color:#888;font-size:13px;margin:0;">戦略書 rev. {{ strategy_revision }} / ベンチマーク: {{ benchmark }}</p>

</div>
</body>
</html>
