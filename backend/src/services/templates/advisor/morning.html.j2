{% from '_macros.j2' import bucket_label, rule_kind_label, action_label, overnight_row_html %}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>朝のタスク {{ today.strftime('%Y-%m-%d') }}</title>
</head>
<body style="margin:0;padding:0;background:#fff;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',sans-serif;font-size:16px;line-height:1.6;color:#222;">
<div style="max-width:600px;margin:0 auto;padding:16px;">

<h1 style="font-size:20px;margin:0 0 16px;">朝のタスク {{ today.strftime('%Y-%m-%d') }}</h1>

{% if rebalance_plan is not none and rebalance_plan.is_rebalance_day %}
<div style="background:#fff8e1;border-left:4px solid #c79100;border-radius:4px;padding:16px;margin:16px 0;">
{% else %}
<div style="background:#f7f9fc;border-left:4px solid #2c5aa0;border-radius:4px;padding:16px;margin:16px 0;">
{% endif %}
  <p style="margin:0 0 8px;font-weight:bold;font-size:18px;">{{ urgency_tag }} — アクション{{ action_count }}件・所要{{ estimated_minutes }}分</p>
  <p style="margin:0;">{{ summary | e | replace('\n\n', '<br><br>') | replace('\n', '<br>') | safe }}</p>
  <p style="margin:8px 0 0;color:#555;font-size:13px;">詳細配分・売買計画は前夜の夕方レポートを参照してください。</p>
</div>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">結論</h2>
{% if rebalance_plan is not none and rebalance_plan.is_rebalance_day %}
<p style="margin:8px 0;font-weight:bold;color:#c79100;">本日は四半期末リバランス基準日です。詳細配分・売買計画は前夜の夕方レポートを参照してください。</p>
{% elif rebalance_plan is not none %}
<p style="margin:8px 0;">本日は通常運用日（次回リバランス <strong>{{ rebalance_plan.next_rebalance_date.strftime('%Y-%m-%d') }}</strong> まで <strong>{{ rebalance_plan.days_to_next_rebalance }}日</strong>）。</p>
{% else %}
<p style="margin:8px 0;">本日は通常運用日。</p>
{% endif %}

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">文脈</h2>
<dl style="margin:0;">
  <dt style="font-weight:bold;margin-top:8px;">資産</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(total_asset) }}円</dd>
{% if daily_change_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">前日比</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(daily_change_pct) }}%</dd>
{% endif %}
{% if month_start_change_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">月初比</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(month_start_change_pct) }}%</dd>
{% endif %}
  <dt style="font-weight:bold;margin-top:8px;">評価額 / 現金</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(total_value) }}円 / {{ "{:,.0f}".format(cash_balance) }}円</dd>
  <dt style="font-weight:bold;margin-top:8px;">保有銘柄数</dt>
  <dd style="margin:0 0 4px 0;">{{ holdings_count }}</dd>
{% if rebalance_plan is not none %}
  <dt style="font-weight:bold;margin-top:8px;">個別逸脱</dt>
  <dd style="margin:0 0 4px 0;">
    {% if rebalance_plan.critical_count > 0 %}<span style="display:inline-block;background:#fdecec;color:#c0392b;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">CRITICAL {{ rebalance_plan.critical_count }}件</span>{% endif %}
    {% if rebalance_plan.warn_count > 0 %}<span style="display:inline-block;background:#fff8e1;color:#c79100;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">WARN {{ rebalance_plan.warn_count }}件</span>{% endif %}
    {% if rebalance_plan.critical_count == 0 and rebalance_plan.warn_count == 0 %}<span style="color:#888;">なし</span>{% endif %}
  </dd>
{% endif %}
</dl>

{% if overnight %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">overnight 市況サマリ</h2>
<table style="width:100%;border-collapse:collapse;font-size:14px;margin:0 0 8px;">
  <thead>
    <tr style="background:#f7f9fc;">
      <th style="padding:6px 8px;text-align:left;border-bottom:1px solid #ddd;">指標</th>
      <th style="padding:6px 8px;text-align:right;border-bottom:1px solid #ddd;">終値</th>
      <th style="padding:6px 8px;text-align:right;border-bottom:1px solid #ddd;">前日比</th>
    </tr>
  </thead>
  <tbody>
    {{ overnight_row_html('S&P500', overnight.get('sp500')) }}
    {{ overnight_row_html('NASDAQ', overnight.get('nasdaq')) }}
    {{ overnight_row_html('DOW', overnight.get('dow')) }}
    {{ overnight_row_html('USD/JPY', overnight.get('usdjpy')) }}
    {{ overnight_row_html('VIX', overnight.get('vix')) }}
    {{ overnight_row_html('日経先物 (NKD)', overnight.get('nikkei_futures')) }}
  </tbody>
</table>
{% endif %}

{% if previous_evening_summary %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">前夜決定事項リマインダー</h2>
{% if previous_evening_summary.is_rebalance_day %}
<p style="margin:8px 0;font-weight:bold;color:#c79100;">本日は四半期末リバランス基準日。詳細は前夜の夕方レポート参照。</p>
{% elif (previous_evening_summary.sell_actions_count or 0) > 0 or (previous_evening_summary.buy_actions_count or 0) > 0 %}
<p style="margin:8px 0;">夕方レポート策定の売買プラン: <strong>売却 {{ previous_evening_summary.sell_actions_count }} 件 / 買付 {{ previous_evening_summary.buy_actions_count }} 件</strong>（詳細は夕方レポート参照）</p>
<p style="margin:8px 0 4px;font-weight:bold;font-size:14px;">主な売却候補</p>
{% if previous_evening_summary.sell_top3 %}
<ul style="margin:0 0 8px;padding-left:20px;">
{% for s in previous_evening_summary.sell_top3 %}
<li style="margin-bottom:4px;font-size:14px;"><strong>{{ s.etf_code }}</strong> {{ s.name }}（約{{ "{:,.0f}".format(s.amount) }}円）</li>
{% endfor %}
</ul>
{% else %}
<p style="margin:0 0 8px;color:#555;font-size:14px;">該当なし</p>
{% endif %}
<p style="margin:8px 0 4px;font-weight:bold;font-size:14px;">主な買付候補</p>
{% if previous_evening_summary.buy_top3 %}
<ul style="margin:0 0 8px;padding-left:20px;">
{% for s in previous_evening_summary.buy_top3 %}
<li style="margin-bottom:4px;font-size:14px;"><strong>{{ s.etf_code }}</strong> {{ s.name }}（約{{ "{:,.0f}".format(s.amount) }}円）</li>
{% endfor %}
</ul>
{% else %}
<p style="margin:0 0 8px;color:#555;font-size:14px;">該当なし</p>
{% endif %}
{% else %}
<p style="margin:8px 0;color:#555;">前夜時点で売買アクションなし（通常運用）。</p>
{% endif %}
{% endif %}

{% if triggers %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">機械ルール</h2>
<ul style="margin:0;padding-left:20px;">
{% for t in triggers %}
<li style="margin-bottom:8px;"><strong>[{{ t.severity }}] {{ rule_kind_label(t.rule_kind) }}</strong>{% if t.code %}（{{ t.code }}）{% endif %}: {{ t.message }}</li>
{% endfor %}
</ul>
{% endif %}

<hr style="border:none;border-top:1px solid #ddd;margin:24px 0 12px;">
<p style="color:#888;font-size:13px;margin:0;">戦略書 rev. {{ strategy_revision }} / ベンチマーク: {{ benchmark }}</p>

</div>
</body>
</html>
