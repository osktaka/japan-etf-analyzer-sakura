<!DOCTYPE html>
<html><body style="font-family: sans-serif; line-height: 1.6;">
<h1>夕方のレビュー {{ today.strftime('%Y-%m-%d') }}（{{ user_id }}）</h1>

<blockquote style="border-left:4px solid #888;padding:8px 12px;background:#f7f7f7;">
<strong>{{ urgency_tag }}</strong> — {{ summary }}
</blockquote>

<h2>根拠データ</h2>
<ul>
<li>総資産: {{ "{:,.0f}".format(total_asset) }} 円 / 評価額: {{ "{:,.0f}".format(total_value) }} 円 / 現金: {{ "{:,.0f}".format(cash_balance) }} 円</li>
<li>保有銘柄数: {{ holdings_count }}</li>
{% if daily_change_pct is not none %}
<li>前日比: {{ "%+.2f"|format(daily_change_pct) }}%</li>
{% endif %}
</ul>

<h2>配分</h2>
<ul>
{% for d in allocation_drifts %}
<li><strong>{{ d.bucket }}</strong>: {{ "%.1f"|format(d.actual_pct) }}% (目標 {{ "%.1f"|format(d.target_pct) }}%, 差 {{ "%+.2f"|format(d.drift_pp) }}pp){% if d.is_warn %} <span style="color:#c00">⚠️ 逸脱</span>{% endif %}</li>
{% endfor %}
</ul>

{% if triggers %}
<h2>機械ルール</h2>
<ul>
{% for t in triggers %}
<li><strong>[{{ t.severity }}] {{ t.rule_kind }}</strong>{% if t.code %} ({{ t.code }}){% endif %}: {{ t.message }}</li>
{% endfor %}
</ul>
{% endif %}

<hr>
<p style="color:#888;font-size:12px;">戦略書: <code>docs/12_personal_strategy.md</code> (rev {{ strategy_revision }}) / ベンチマーク: {{ benchmark }}</p>
</body></html>
