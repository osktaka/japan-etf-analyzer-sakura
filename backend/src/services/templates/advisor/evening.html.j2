{% from '_macros.j2' import bucket_label, rule_kind_label, action_label, holdings_table_html, non_adopted_html, trade_actions_html, trade_summary_html %}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>夕方のレビュー {{ today.strftime('%Y-%m-%d') }}</title>
</head>
<body style="margin:0;padding:0;background:#fff;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',sans-serif;font-size:16px;line-height:1.6;color:#222;">
<div style="max-width:600px;margin:0 auto;padding:16px;">

<h1 style="font-size:20px;margin:0 0 16px;">夕方のレビュー {{ today.strftime('%Y-%m-%d') }}</h1>

<div style="background:#f7f9fc;border-left:4px solid #2c5aa0;border-radius:4px;padding:16px;margin:16px 0;">
  <p style="margin:0 0 8px;font-weight:bold;font-size:18px;">{{ urgency_tag }}</p>
  <p style="margin:0;">{{ summary | e | replace('\n\n', '<br><br>') | replace('\n', '<br>') | safe }}</p>
</div>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">本日の市場文脈</h2>
<dl style="margin:0;">
  <dt style="font-weight:bold;margin-top:8px;">資産</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(total_asset) }}円</dd>
{% if daily_change_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">前日比</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(daily_change_pct) }}%</dd>
{% endif %}
{% if month_start_change_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">月初比</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(month_start_change_pct) }}%</dd>
{% endif %}
  <dt style="font-weight:bold;margin-top:8px;">評価額 / 現金</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(total_value) }}円 / {{ "{:,.0f}".format(cash_balance) }}円</dd>
  <dt style="font-weight:bold;margin-top:8px;">保有銘柄数</dt>
  <dd style="margin:0 0 4px 0;">{{ holdings_count }}</dd>
</dl>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">配分</h2>
<ul style="margin:0;padding-left:20px;">
{% for d in allocation_drifts if d.bucket != "other" %}
<li style="margin-bottom:8px;">
  {% if d.is_warn %}<span style="display:inline-block;background:#fce4e4;color:#c00;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">警告</span>{% endif %}
  <strong>{{ bucket_label(d.bucket) }}</strong>: {{ "%.1f"|format(d.actual_pct) }}%（目標 {{ "%.1f"|format(d.target_pct) }}%、差 {{ "%+.2f"|format(d.drift_pp) }}pp）
</li>
{% endfor %}
</ul>

{% if rebalance_plan is not none %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">採用銘柄配分</h2>
{{ holdings_table_html(rebalance_plan, drift_warn_pp, drift_ok_pp) }}

{% set non_adopted = rebalance_plan.holdings_snapshots | rejectattr("is_adopted") | list %}
{% if non_adopted %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">採用外保有（次回リバランスで全量売却推奨）</h2>
{{ non_adopted_html(rebalance_plan) }}
{% endif %}

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">売買プラン概要</h2>
{{ trade_summary_html(rebalance_plan.sell_actions|length, rebalance_plan.buy_actions|length, sell_top3, buy_top3, rebalance_plan.next_rebalance_date, rebalance_plan.days_to_next_rebalance) }}

{% if rebalance_plan.is_rebalance_day or rebalance_plan.days_to_next_rebalance <= rebalance_detail_threshold_days %}
{% if rebalance_plan.is_rebalance_day %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">本日のリバランス実行</h2>
{{ trade_actions_html(rebalance_plan.sell_actions, rebalance_plan.buy_actions) }}
{% else %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">次回基準日（{{ rebalance_plan.next_rebalance_date.strftime('%Y-%m-%d') }}、あと {{ rebalance_plan.days_to_next_rebalance }} 日）への売却/買付プラン（詳細）</h2>
{{ trade_actions_html(rebalance_plan.sell_actions, rebalance_plan.buy_actions) }}
{% endif %}
{% endif %}
{% else %}
{% set non_adopted_drifts = allocation_drifts | selectattr("bucket", "equalto", "other") | list %}
{% if non_adopted_drifts %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">採用外保有</h2>
<ul style="margin:0;padding-left:20px;">
{% for d in non_adopted_drifts %}
<li style="margin-bottom:8px;">
  <strong>{{ bucket_label(d.bucket) }}</strong>: {{ "%.1f"|format(d.actual_pct) }}% — 次回リバランスで売却推奨
</li>
{% endfor %}
</ul>
{% endif %}
{% endif %}

{% if triggers %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">機械ルール</h2>
<ul style="margin:0;padding-left:20px;">
{% for t in triggers %}
<li style="margin-bottom:8px;"><strong>[{{ t.severity }}] {{ rule_kind_label(t.rule_kind) }}</strong>{% if t.code %}（{{ t.code }}）{% endif %}: {{ t.message }}</li>
{% endfor %}
</ul>
{% endif %}

<hr style="border:none;border-top:1px solid #ddd;margin:24px 0 12px;">
<p style="color:#888;font-size:13px;margin:0;">戦略書 rev. {{ strategy_revision }} / ベンチマーク: {{ benchmark }}</p>

</div>
</body>
</html>
