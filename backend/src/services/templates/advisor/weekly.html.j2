{% from '_macros.j2' import bucket_label, rule_kind_label, action_label %}
{% set warn_drifts = allocation_drifts | selectattr("is_warn") | list %}
{% set drift_buys = allocation_drifts | selectattr("drift_pp", "lt", -5.0) | list %}
{% set drift_sells = allocation_drifts | selectattr("drift_pp", "gt", 5.0) | list %}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>週次レビュー {{ today.strftime('%Y-%m-%d') }}</title>
</head>
<body style="margin:0;padding:0;background:#fff;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',sans-serif;font-size:16px;line-height:1.6;color:#222;">
<div style="max-width:600px;margin:0 auto;padding:16px;">

<h1 style="font-size:20px;margin:0 0 16px;">週次レビュー {{ today.strftime('%Y-%m-%d') }}</h1>

<div style="background:#f7f9fc;border-left:4px solid #2c5aa0;border-radius:4px;padding:16px;margin:16px 0;">
  <p style="margin:0 0 8px;font-weight:bold;font-size:18px;">{{ urgency_tag }}{% if alpha_pp is not none %} — α {{ "%+.2f"|format(alpha_pp) }}pp / 配分逸脱{{ warn_drifts | length }}件{% endif %}</p>
  <p style="margin:0;">{{ summary | e | replace('\n\n', '<br><br>') | replace('\n', '<br>') | safe }}</p>
</div>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">5営業日サマリ</h2>
<dl style="margin:0;">
  <dt style="font-weight:bold;margin-top:8px;">期間</dt>
  <dd style="margin:0 0 4px 0;">{{ period_label or "過去5営業日" }}</dd>
{% if portfolio_return_pct is not none and benchmark_return_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">ポートフォリオ</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(portfolio_return_pct) }}%</dd>
  <dt style="font-weight:bold;margin-top:8px;">ベンチマーク（{{ benchmark }}）</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(benchmark_return_pct) }}%</dd>
  <dt style="font-weight:bold;margin-top:8px;">α</dt>
  <dd style="margin:0 0 4px 0;"><strong>{{ "%+.2f"|format(alpha_pp) }}pp</strong></dd>
{% else %}
  <dt style="font-weight:bold;margin-top:8px;">α</dt>
  <dd style="margin:0 0 4px 0;">データ不足のため算出不可</dd>
{% endif %}
{% if month_start_change_pct is not none %}
  <dt style="font-weight:bold;margin-top:8px;">月初比</dt>
  <dd style="margin:0 0 4px 0;">{{ "%+.2f"|format(month_start_change_pct) }}%</dd>
{% endif %}
  <dt style="font-weight:bold;margin-top:8px;">資産 / 評価額 / 現金</dt>
  <dd style="margin:0 0 4px 0;">{{ "{:,.0f}".format(total_asset) }}円 / {{ "{:,.0f}".format(total_value) }}円 / {{ "{:,.0f}".format(cash_balance) }}円</dd>
  <dt style="font-weight:bold;margin-top:8px;">保有銘柄数</dt>
  <dd style="margin:0 0 4px 0;">{{ holdings_count }}</dd>
</dl>

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">配分カテゴリ別</h2>
<ul style="margin:0;padding-left:20px;">
{% for d in allocation_drifts %}
<li style="margin-bottom:8px;">
  {% if d.is_warn %}<span style="display:inline-block;background:#fce4e4;color:#c00;padding:2px 8px;border-radius:4px;font-size:12px;margin-right:6px;">警告</span>{% endif %}
  <strong>{{ bucket_label(d.bucket) }}</strong>: {{ "%.1f"|format(d.actual_pct) }}%（目標 {{ "%.1f"|format(d.target_pct) }}%、差 {{ "%+.2f"|format(d.drift_pp) }}pp）
</li>
{% endfor %}
</ul>

{% if (alpha_pp is not none and alpha_pp <= -2.0) or drift_buys or drift_sells %}
<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">来週の推奨アクション</h2>
<ul style="margin:0;padding-left:20px;">
{% if alpha_pp is not none and alpha_pp <= -2.0 %}
<li style="margin-bottom:8px;">コア（市場全体）ETFの追加買付を検討（α {{ "%+.2f"|format(alpha_pp) }}pp）</li>
<li style="margin-bottom:8px;">現金比率が高い場合は段階的に投入を検討</li>
{% endif %}
{% for d in drift_buys %}
<li style="margin-bottom:8px;"><strong>{{ bucket_label(d.bucket) }}</strong> が {{ "%.1f"|format(d.drift_pp | abs) }}pp 不足 — 買付推奨</li>
{% endfor %}
{% for d in drift_sells %}
<li style="margin-bottom:8px;"><strong>{{ bucket_label(d.bucket) }}</strong> が +{{ "%.1f"|format(d.drift_pp) }}pp 過剰 — 売却検討</li>
{% endfor %}
</ul>
{% endif %}

<h2 style="font-size:18px;margin:24px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">今週発動した機械ルール</h2>
{% if triggers %}
<ul style="margin:0;padding-left:20px;">
{% for t in triggers %}
<li style="margin-bottom:8px;"><strong>[{{ t.severity }}] {{ rule_kind_label(t.rule_kind) }}</strong>{% if t.code %}（{{ t.code }}）{% endif %}: {{ t.message }}</li>
{% endfor %}
</ul>
{% else %}
<p style="margin:8px 0;">特になし。</p>
{% endif %}

<hr style="border:none;border-top:1px solid #ddd;margin:24px 0 12px;">
<p style="color:#888;font-size:13px;margin:0;">戦略書 rev. {{ strategy_revision }} / ベンチマーク: {{ benchmark }}</p>

</div>
</body>
</html>
