<!DOCTYPE html>
<html><body style="font-family: sans-serif; line-height: 1.6;">
<h1>週次レビュー {{ today.strftime('%Y-%m-%d') }}（{{ user_id }}）</h1>

<blockquote style="border-left:4px solid #888;padding:8px 12px;background:#f7f7f7;">
<strong>{{ urgency_tag }}</strong> — {{ summary }}
</blockquote>

<p>期間: {{ period_label or "過去5営業日" }}</p>

<h2>根拠データ</h2>
<ul>
<li>総資産: {{ "{:,.0f}".format(total_asset) }} 円 / 評価額: {{ "{:,.0f}".format(total_value) }} 円 / 現金: {{ "{:,.0f}".format(cash_balance) }} 円</li>
<li>保有銘柄数: {{ holdings_count }}</li>
</ul>

<h2>ベンチマーク比較</h2>
{% if portfolio_return_pct is not none and benchmark_return_pct is not none %}
<ul>
<li>ポートフォリオ: {{ "%+.2f"|format(portfolio_return_pct) }}%</li>
<li>{{ benchmark }}: {{ "%+.2f"|format(benchmark_return_pct) }}%</li>
<li>α: <strong>{{ "%+.2f"|format(alpha_pp) }}pp</strong></li>
</ul>
{% else %}
<p>データ不足のためα算出不可</p>
{% endif %}

<h2>配分</h2>
<ul>
{% for d in allocation_drifts %}
<li><strong>{{ d.bucket }}</strong>: {{ "%.1f"|format(d.actual_pct) }}% (目標 {{ "%.1f"|format(d.target_pct) }}%, 差 {{ "%+.2f"|format(d.drift_pp) }}pp){% if d.is_warn %} <span style="color:#c00">⚠️</span>{% endif %}</li>
{% endfor %}
</ul>

{% set drift_buys = allocation_drifts | selectattr("drift_pp", "lt", -5.0) | list %}
{% set drift_sells = allocation_drifts | selectattr("drift_pp", "gt", 5.0) | list %}
{% if (alpha_pp is not none and alpha_pp <= -2.0) or drift_buys or drift_sells %}
<h2>来週の推奨アクション</h2>
<ul>
{% if alpha_pp is not none and alpha_pp <= -2.0 %}
<li>core ETFの追加買付を検討（α {{ "%+.2f"|format(alpha_pp) }}pp）</li>
<li>現金比率が高い場合は段階的に投入を検討</li>
{% endif %}
{% for d in drift_buys %}
<li><code>{{ d.bucket }}</code> が {{ "%.1f"|format(d.drift_pp | abs) }}pp 不足 — 買付推奨</li>
{% endfor %}
{% for d in drift_sells %}
<li><code>{{ d.bucket }}</code> が +{{ "%.1f"|format(d.drift_pp) }}pp 過剰 — 売却検討</li>
{% endfor %}
</ul>
{% endif %}

{% if triggers %}
<h2>今週の機械ルール発動</h2>
<ul>
{% for t in triggers %}
<li><strong>[{{ t.severity }}] {{ t.rule_kind }}</strong>{% if t.code %} ({{ t.code }}){% endif %}: {{ t.message }}</li>
{% endfor %}
</ul>
{% endif %}

<hr>
<p style="color:#888;font-size:12px;">戦略書: <code>docs/12_personal_strategy.md</code> (rev {{ strategy_revision }}) / ベンチマーク: {{ benchmark }}</p>
</body></html>
