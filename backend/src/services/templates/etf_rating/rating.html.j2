{% import '_macros.j2' as m -%}
{# HTML版 ETF Rating メール本文（短文フォーマット / 2026-07-23〜）.
   構造: 今日の要点 → スコア一覧 → 動きがあった銘柄 → 注意ポイント → フッタ.
   銘柄別4部構成ブロック（ひとこと/Top5/リスク/3シナリオ）と20項目 <details> は廃止。
   詳細は reports/etf-rating/ 配下の銘柄別レポートに委譲する。

   movers / cautions / movers_threshold_label は etf_rating_notifier._render() が
   calc_params.json の mail.* 閾値で抽出して渡す（欠損キー耐性のため Jinja では導出しない）。

   受け付けるキーは正規キーのみ:
   - r.delta_net / r.upside_weighted / r.downside_weighted
   - r.top_drivers_bearish_labels（注意ポイントの理由に使用）
#}
{%- set total = ratings|length -%}
{%- set avg = (ratings|sum(attribute='net_score') / total)|round(1) if total > 0 else None -%}
{# 件数は flags リスト（type=strong_tailwind / severe_risk 等）で集計し、件名と一致させる #}
{%- set tailwind_count = flags|selectattr('type', 'in', ['strong_tailwind', 'strong_bullish'])|list|length if flags else 0 -%}
{%- set warning_count = flags|selectattr('type', 'in', ['severe_risk', 'critical_risk', 'warning'])|list|length if flags else 0 -%}
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#fff;font-family:-apple-system,BlinkMacSystemFont,'Hiragino Sans','Yu Gothic',sans-serif;font-size:14px;line-height:1.7;color:#222;">
<div style="max-width:600px;margin:0 auto;padding:16px;">

<h1 style="font-size:17px;margin:0 0 12px;color:#222;">{{ today_iso[5:7]|int }}月{{ today_iso[8:10]|int }}日 ETF Rating（終値ベース・{{ total }}銘柄）</h1>

<div style="margin:12px 0;padding:12px;background:#f7f9fc;border-left:4px solid #3a7d1b;">
  <p style="margin:0 0 6px;font-weight:bold;font-size:15px;">■ 今日の要点</p>
  <p style="margin:0;font-size:14px;color:#333;">{{ summary_text|default('（総評コメントなし）') }}</p>
</div>

<div style="margin:16px 0;">
  <h2 style="font-size:15px;margin:0 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">■ スコア一覧</h2>
  <table style="border-collapse:collapse;width:100%;font-size:13px;">
    <thead>
      <tr style="background:#eef2f7;">
        <th style="padding:6px;text-align:left;border:1px solid #ddd;">銘柄</th>
        <th style="padding:6px;text-align:right;border:1px solid #ddd;">総合</th>
        <th style="padding:6px;text-align:right;border:1px solid #ddd;">前日比</th>
        <th style="padding:6px;text-align:left;border:1px solid #ddd;">判定</th>
      </tr>
    </thead>
    <tbody>
      {% for r in ratings %}
      <tr style="background:{{ '#fff' if loop.index is odd else '#fafbfc' }};">
        <td style="padding:6px;border:1px solid #ddd;"><strong>{{ r.code }}</strong> {{ r.name|default('-') }}</td>
        <td style="padding:6px;border:1px solid #ddd;text-align:right;"><strong>{{ '%.1f'|format(r.net_score) }}</strong></td>
        <td style="padding:6px;border:1px solid #ddd;text-align:right;font-size:12px;">{{ m.signed_delta(r.delta_net) }}</td>
        <td style="padding:6px;border:1px solid #ddd;">{{ m.verdict_badge_html(r.net_score) | safe }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p style="margin:8px 0 0;font-size:13px;color:#555;">平均 <strong>{{ avg }}点</strong>／強い追い風 <strong>{{ tailwind_count }}銘柄</strong>／警戒 <strong>{{ warning_count }}銘柄</strong></p>
</div>

<div style="margin:16px 0;">
  <h2 style="font-size:15px;margin:0 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px;">■ 動きがあった銘柄（前日比±{{ movers_threshold_label|default('3') }}pt以上）</h2>
  {% if movers %}
  <ul style="margin:0;padding-left:20px;font-size:13px;">
    {% for r in movers %}
    <li style="margin-bottom:6px;">
      <strong>{{ r.code }} {{ r.name|default('-') }}（{{ m.signed_delta(r.delta_net) }}）</strong>：{{ (r.executive_note or r.notes or '')|truncate(90, true, '…') }}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p style="margin:4px 0;font-size:13px;color:#555;">本日は大きなスコア変動はありません。</p>
  {% endif %}
</div>

{% if cautions %}
<div style="margin:16px 0;padding:10px 12px;background:#fff8e1;border-left:4px solid #c79100;">
  <p style="margin:0 0 6px;font-weight:bold;font-size:14px;">■ 注意ポイント</p>
  <ul style="margin:0;padding-left:20px;font-size:13px;">
    {% for r in cautions %}
    <li style="margin-bottom:4px;"><strong>{{ r.code }} {{ r.name|default('-') }}</strong>: {{ (r.top_drivers_bearish_labels|default([], true))|first|default('下落リスク ' + '%.1f'|format(r.downside_weighted|default(0, true))) }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

{% if criteria_warnings %}
<div style="margin:16px 0;">
  <h2 style="font-size:14px;margin:0 0 8px;color:#a85400;">■ 観点鮮度の警告</h2>
  <ul style="margin:0;padding-left:20px;font-size:13px;">
    {% for w in criteria_warnings %}
    <li style="margin-bottom:4px;color:{{ m.version_freshness_color(w.age_days) }};">
      <strong>{{ w.code }}</strong>: {{ w.version }}（{{ w.age_days }}日経過, {{ w.mark|default('-') }}）
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<hr style="border:none;border-top:1px solid #ddd;margin:20px 0 12px;">
<div style="color:#666;font-size:12px;line-height:1.6;">
  <p style="margin:0 0 4px;">判定基準: 70〜🟢強い追い風／60〜🟢追い風／40〜🟡中立寄り／30〜🔴警戒／30未満🔴重大警戒</p>
  <p style="margin:0 0 4px;">銘柄別の詳細（Top5・リスク・3シナリオ・20項目スコア）は reports/etf-rating/{銘柄コード}/ のレポートを参照してください。</p>
  <p style="margin:0;">次回 tune 推奨日: {{ next_tune_date|default('-') }} ／ 送信時刻: {{ sent_at }}</p>
</div>

</div>
</body>
</html>
